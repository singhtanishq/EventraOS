# Frontend Environment Variables
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=EventraOS
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_HOTELS=true
VITE_ENABLE_FLIGHTS=true
VITE_ENABLE_TRAINS=true
VITE_ENABLE_BUSES=true
VITE_ENABLE_VENUES=true
VITE_ENABLE_CARS=true
VITE_ENABLE_ACTIVITIES=true
VITE_ENABLE_TRANSFERS=true
VITE_ENABLE_PACKAGES=true
VITE_ENABLE_LOYALTY=true
VITE_ENABLE_WALLET=true

# Payment Configuration
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=
VITE_MIXPANEL_TOKEN=

# Maps (Optional)
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=